// F3VB Engine: icone (logo do projeto, arte do autor) e informacoes de versao do F3VB.exe
#include <windows.h>

1 ICON "f3vb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 21,0,0,0
 PRODUCTVERSION 21,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "F3VB Engine"
            VALUE "FileDescription", "F3VB Engine"
            VALUE "FileVersion", "21.0"
            VALUE "InternalName", "F3VB"
            VALUE "OriginalFilename", "F3VB.exe"
            VALUE "ProductName", "F3VB Engine"
            VALUE "ProductVersion", "v21"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
